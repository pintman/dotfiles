#!/bin/sh
# Ruff-Check vor jedem Commit. Aktivieren mit: git config core.hooksPath git-hooks

if ! command -v ruff >/dev/null 2>&1; then
    echo "ruff nicht gefunden. Installieren mit: pipx install ruff" >&2
    exit 1
fi

# nur getrackte Dateien pruefen, sonst blockieren generierte/untracked Skill-Caches jeden Commit
tracked_py_files=$(git ls-files -- '*.py')
if [ -z "$tracked_py_files" ]; then
    exit 0
fi

echo "$tracked_py_files" | xargs ruff check
if [ $? -ne 0 ]; then
    echo "Ruff hat Probleme gefunden. Commit abgebrochen."
    exit 1
fi
